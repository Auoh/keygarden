{
  "name": "keygarden",
  "version": "0.1.0",
  "private": true,
  "description": "键息花园 — a quiet desktop garden that grows from your normal typing.",
  "main": "src/main/main.js",
  "author": "Auoh",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node scripts/launch-electron.js .",
    "start:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "dev": "node scripts/launch-electron.js . --dev",
    "build:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-helper.ps1",
    "package": "node scripts/package-portable.js",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^43.3.0"
  },
  "allowScripts": {
    "electron@43.3.0": true
  }
}
